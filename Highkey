local function loadFriends(userId)
    for _,c in ipairs(FriendsScroll:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
    end
    FriendsLoadingLabel.Text="Loading friends..." FriendsLoadingLabel.Visible=true FriendsPanel.Visible=true
    task.spawn(function()
        local ok,pages=pcall(function() return Players:GetFriendsAsync(userId) end)
        if not ok then FriendsLoadingLabel.Text="Failed to load friends." return end
        FriendsLoadingLabel.Visible=false
        local order=1
        local function processPage(page)
            for _,fd in ipairs(page) do
                local row=Instance.new("TextButton",FriendsScroll)
                row.Size=UDim2.new(1,0,0,46) row.BackgroundColor3=Color3.fromRGB(22,22,22)
                row.BorderSizePixel=0 row.LayoutOrder=order row.Text="" row.AutoButtonColor=false
