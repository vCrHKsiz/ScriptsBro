local function loadMoreInfo(userId)
    getAvatar(userId,HudAvatar)
    HudNameLabel.Text=ProfileDisplayName.Text~="" and ProfileDisplayName.Text or "—"
    HudUsernameLabel.Text=ProfileUsername.Text~="" and ProfileUsername.Text or "—"
    HudUserIdLabel.Text="ID: "..tostring(userId)
    local ld="loading..."
    HudCreated.Text=ld HudAccAge.Text=ld HudPastNames.Text=ld
    HudFriends.Text=ld HudFollowers.Text=ld HudFollowing.Text=ld
    HudLastOnline.Text=ld HudJoinDate.Text=ld HudInventory.Text=ld HudBadges.Text=ld
    HudLoading.Visible=true
    task.spawn(function()
        local tp=Players:GetPlayerByUserId(userId)
        if tp then
            local days=tp.AccountAge
            HudAccAge.Text=fmtAge(days)
            local cd=os.date("*t",os.time()-days*86400)
            HudCreated.Text=MN[cd.month].." "..cd.day..", "..cd.year
            HudJoinDate.Text=MN[cd.month].." "..cd.year
        end
    end)
    task.spawn(function()
        local ok,pages=pcall(Players.GetFriendsAsync,Players,userId)
        if ok and pages then
            local cnt=#pages:GetCurrentPage()
            while not pages.IsFinished do
                if not pcall(function() pages:AdvanceToNextPageAsync() end) then break end
                cnt=cnt+#pages:GetCurrentPage()
            end
            HudFriends.Text=tostring(cnt)
        else HudFriends.Text="N/A" end
    end)
    task.spawn(function()
        local d1=jd(tryGet("https://users.roblox.com/v1/users/"..userId))
        if d1 and d1.created then
            local yr=tonumber(d1.created:match("^(%d+)")) or 2006
            local mo=tonumber(d1.created:match("^%d+%-(%d+)")) or 1
            local dy=tonumber(d1.created:match("^%d+%-%d+%-(%d+)")) or 1
            local ok2,ts=pcall(os.time,{year=yr,month=mo,day=dy,hour=0,min=0,sec=0})
            if ok2 and HudAccAge.Text=="loading..." then
                HudAccAge.Text=fmtAge(math.floor((os.time()-ts)/86400))
                HudCreated.Text=MN[mo].." "..dy..", "..yr
                HudJoinDate.Text=MN[mo].." "..yr
            end
        end
        local d2=jd(tryGet("https://users.roblox.com/v1/users/"..userId.."/username-history?limit=10&sortOrder=Desc"))
        if d2 and d2.data then
            if #d2.data>0 then
                local ns={} for _,e in ipairs(d2.data) do table.insert(ns,e.name) end
                HudPastNames.Text=table.concat(ns,", ")
            else HudPastNames.Text="None" end
        else HudPastNames.Text="N/A" end
        local d3=jd(tryGet("https://friends.roblox.com/v1/users/"..userId.."/followers/count"))
        if d3 and d3.count~=nil then
            local n=d3.count
            if n>=1000000 then HudFollowers.Text=("%.1fM"):format(n/1000000)
            elseif n>=1000 then HudFollowers.Text=("%.1fK"):format(n/1000)
            else HudFollowers.Text=tostring(n) end
        else HudFollowers.Text="N/A" end
        local d4=jd(tryGet("https://friends.roblox.com/v1/users/"..userId.."/followings/count"))
        HudFollowing.Text=(d4 and d4.count~=nil) and tostring(d4.count) or "N/A"
        local pb=HttpService:JSONEncode({userIds={userId}})
        local d5=jd(tryPost("https://presence.roblox.com/v1/presence/users",pb))
        if d5 and d5.userPresences and d5.userPresences[1] then
            local p=d5.userPresences[1]
            local pt={[0]="Offline",[1]="Website",[2]="In-Game",[3]="Studio"}
            local s=pt[p.userPresenceType] or "Unknown"
            if p.lastLocation and p.lastLocation~="" and p.userPresenceType==2 then s=p.lastLocation end
            HudLastOnline.Text=s
        else HudLastOnline.Text=Players:GetPlayerByUserId(userId) and "In server" or "N/A" end
        local d6=jd(tryGet("https://badges.roblox.com/v1/users/"..userId.."/badges?limit=100&sortOrder=Desc"))
        if d6 and d6.data then HudBadges.Text=d6.nextPageCursor and (#d6.data.."+") or tostring(#d6.data)
        else HudBadges.Text="N/A" end
        local d7=jd(tryGet("https://inventory.roblox.com/v1/users/"..userId.."/assets/collectibles?limit=100"))
        if d7 and d7.data then HudInventory.Text=d7.nextPageCursor and (#d7.data.."+ items") or (#d7.data.." items")
        else HudInventory.Text="Private" end
        HudLoading.Visible=false
    end)
end
