                local av=Instance.new("ImageLabel",row)
                av.Size=UDim2.new(0,34,0,34) av.Position=UDim2.new(0,8,0.5,-17)
                av.BackgroundColor3=Color3.fromRGB(35,35,35) av.Image=""
                Instance.new("UICorner",av).CornerRadius=UDim.new(0,5)
                getAvatar(fd.Id,av)
                local dn=Instance.new("TextLabel",row)
                dn.Size=UDim2.new(1,-56,0,18) dn.Position=UDim2.new(0,50,0,8)
                dn.BackgroundTransparency=1 dn.Text=fd.DisplayName dn.TextColor3=Color3.new(1,1,1)
                dn.Font=Enum.Font.GothamBold dn.TextSize=12 dn.TextXAlignment=Enum.TextXAlignment.Left dn.TextTruncate=Enum.TextTruncate.AtEnd
                local un=Instance.new("TextLabel",row)
                un.Size=UDim2.new(1,-56,0,14) un.Position=UDim2.new(0,50,0,26)
                un.BackgroundTransparency=1 un.Text="@"..fd.Username un.TextColor3=Color3.fromRGB(110,110,110)
                un.Font=Enum.Font.Gotham un.TextSize=10 un.TextXAlignment=Enum.TextXAlignment.Left
                local cId,cDN,cUN=fd.Id,fd.DisplayName,fd.Username
                row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(40,10,60) end)
                row.MouseLeave:Connect(function() row.BackgroundColor3=Color3.fromRGB(22,22,22) end)
                row.MouseButton1Click:Connect(function()
                    currentProfileId=cId
                    getAvatar(cId,ProfileAvatar)
                    ProfileDisplayName.Text=cDN ProfileUsername.Text="@"..cUN
                    InfoDisplay.Text=cDN InfoUsername.Text="@"..cUN StatID.Text=tostring(cId)
                    YouBadge.Visible=false LegendBadge.Visible=legendUsernames[cUN]==true
                    StatFriends.Text="..." StatAge.Text="..." InfoCreated.Text="..." InfoDesc.Text="..."
                    if moreInfoActive then resetHud() HudPanel.Visible=false end
                    task.spawn(function()
                        local fok,fr=pcall(function()
                            local fp2=Players:GetFriendsAsync(cId) local cnt=0
                            for _ in ipairs(fp2:GetCurrentPage()) do cnt=cnt+1 end
                            while not fp2.IsFinished do
                                if not pcall(function() fp2:AdvanceToNextPageAsync() end) then break end
                                for _ in ipairs(fp2:GetCurrentPage()) do cnt=cnt+1 end
                            end
                            return cnt
                        end)
                        StatFriends.Text=fok and tostring(fr) or "?"
                        local d=jd(tryGet("https://users.roblox.com/v1/users/"..cId))
                        if d then
                            InfoDesc.Text=(d.description and d.description~="") and d.description or "No description"
                            if d.created then
                                local mo=tonumber(d.created:match("^%d+%-(%d+)")) or 1
                                InfoCreated.Text=MN[mo].." "..(d.created:match("^(%d+)") or "?")
                            end
                        else InfoDesc.Text="No description" end
                        local tp=Players:GetPlayerByUserId(cId)
                        if tp then local ad=tp.AccountAge
                            StatAge.Text=ad>=365 and math.floor(ad/365).."yr" or ad>=30 and math.floor(ad/30).."mo" or ad.."d"
                        else StatAge.Text="?" end
                    end)
                    profileExpanded=true ProfileExpandBtn.Text="▼" ProfileBody.Visible=true
                    ProfilePanel.Size=UDim2.new(0,280,0,PROFILE_EXPANDED_H) ProfilePanel.Visible=true
                end)
                FriendsScroll.CanvasSize=UDim2.new(0,0,0,FriendsLayout.AbsoluteContentSize.Y+8)
            end
        end
        processPage(pages:GetCurrentPage())
        while not pages.IsFinished do
            if not pcall(function() pages:AdvanceToNextPageAsync() end) then break end
            processPage(pages:GetCurrentPage())
        end
        if order==1 then FriendsLoadingLabel.Text="No friends found." FriendsLoadingLabel.Visible=true end
    end)
end
